    ∃ (W : List ℕ) (G : Angle → LowGate), PolicyImplX policy X 2048 W G ∧
      ∀ φ, LowGate.qubitCount (policy).resourceModel (G φ) ≤ 6405 := by
  obtain ⟨W, G, hI, h⟩ := ptp_peak_qubits_exact policy 2048 X base check hG
  refine ⟨W, G, hI, fun φ => ?_⟩
  have h3 := (h φ).2.2
  rw [oneQubit_exact.2.2.2] at h3
  exact h3

