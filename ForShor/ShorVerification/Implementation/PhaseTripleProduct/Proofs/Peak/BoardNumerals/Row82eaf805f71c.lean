    ptpPeakQubits policy ptpScanWidth 2048 = 3 * 2048 + 515 + 1 ∧ ptpPeakQubits policy ptpScanWidth 2048 = 6660 := by
  decide +kernel

/-- The `ptpQubits` formula (scan widths), `oneQubit`: 7442. -/
theorem oneQubit_ptpQubits : ptpQubits policy 2048 = 7442 := by decide +kernel

/-- `scratch`, the exact rule (the board's): workspace 260, clean scratch 1, peak `3 * 2048 + 260 + 1 = 6405`. -/
theorem scratch_exact :
    ptpWsTD (policy.withNegation .scratch) exactRule 2048 = 260 ∧ ptpCleanAncD (policy.withNegation .scratch) exactRule 2048 = 1 ∧
    ptpPeakQubits (policy.withNegation .scratch) exactRule 2048 = 3 * 2048 + 260 + 1 ∧ ptpPeakQubits (policy.withNegation .scratch) exactRule 2048 = 6405 := by
  decide +kernel

/-- `scratch`, the scan rule: workspace 515, clean scratch 1, peak `3 * 2048 + 515 + 1 = 6660`. -/
