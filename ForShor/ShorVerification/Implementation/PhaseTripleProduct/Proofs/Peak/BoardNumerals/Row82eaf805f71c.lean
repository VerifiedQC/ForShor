namespace Shor.PTP.Peak.Board.Row82eaf805f71c

open Shor PolicySubmission.Policies.Board.Row82eaf805f71c

/-- No table of this policy contains a `negate`, so the negation method cannot enter its census. -/
theorem no_negate : policy.bands.map (fun b => negCount b.table.ops) = [0] := by decide +kernel

/-- The Lean policy is board row `82eaf805f71c`: its exact-width ladder from 2048 is the ladder printed on the row,
`2048:4 -> 522:4 -> 142:leaf` (re-exported from `PolicySubmission.Policies.Board.Row82eaf805f71c.ladder_exact`). -/
theorem board_ladder : policy.ladderX 2048 = [(2048, some 4), (522, some 4), (142, none)] :=
  ladder_exact

/-- `oneQubit`, the exact rule (the board's): workspace 260, clean scratch 1, peak `3 * 2048 + 260 + 1 = 6405`. -/
theorem oneQubit_exact :
    ptpWsTD policy exactRule 2048 = 260 ∧ ptpCleanAncD policy exactRule 2048 = 1 ∧
    ptpPeakQubits policy exactRule 2048 = 3 * 2048 + 260 + 1 ∧ ptpPeakQubits policy exactRule 2048 = 6405 := by
  decide +kernel

/-- `oneQubit`, the scan rule: workspace 515, clean scratch 1, peak `3 * 2048 + 515 + 1 = 6660`. -/
theorem oneQubit_scan :
