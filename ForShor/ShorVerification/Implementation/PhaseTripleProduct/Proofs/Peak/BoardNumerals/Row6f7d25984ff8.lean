namespace Shor.PTP.Peak.Board.Row6f7d25984ff8

open Shor PolicySubmission.Policies.Board.Row6f7d25984ff8

/-- No table of this policy contains a `negate`, so the negation method cannot enter its census. -/
theorem no_negate : policy.bands.map (fun b => negCount b.table.ops) = [0, 0] := by decide +kernel

/-- The Lean policy is board row `6f7d25984ff8`: its exact-width ladder from 2048 is the ladder printed on the row,
`2048:8 -> 292:4 -> 80:leaf` (re-exported from `PolicySubmission.Policies.Board.Row6f7d25984ff8.ladder_exact`). -/
theorem board_ladder : policy.ladderX 2048 = [(2048, some 8), (292, some 4), (80, none)] :=
  ladder_exact

/-- `oneQubit`, the exact rule (the board's): workspace 950, clean scratch 1, peak `3 * 2048 + 950 + 1 = 7095`. -/
theorem oneQubit_exact :
    ptpWsTD policy exactRule 2048 = 950 ∧ ptpCleanAncD policy exactRule 2048 = 1 ∧
    ptpPeakQubits policy exactRule 2048 = 3 * 2048 + 950 + 1 ∧ ptpPeakQubits policy exactRule 2048 = 7095 := by
  decide +kernel

/-- `oneQubit`, the scan rule: workspace 6206, clean scratch 1, peak `3 * 2048 + 6206 + 1 = 12351`. -/
theorem oneQubit_scan :
    ptpWsTD policy ptpScanWidth 2048 = 6206 ∧ ptpCleanAncD policy ptpScanWidth 2048 = 1 ∧
    ptpPeakQubits policy ptpScanWidth 2048 = 3 * 2048 + 6206 + 1 ∧ ptpPeakQubits policy ptpScanWidth 2048 = 12351 := by
  decide +kernel

/-- The `ptpQubits` formula (scan widths), `oneQubit`: 14786. -/
theorem oneQubit_ptpQubits : ptpQubits policy 2048 = 14786 := by decide +kernel

/-- `scratch`, the exact rule (the board's): workspace 950, clean scratch 1, peak `3 * 2048 + 950 + 1 = 7095`. -/
theorem scratch_exact :
    ptpWsTD (policy.withNegation .scratch) exactRule 2048 = 950 ∧ ptpCleanAncD (policy.withNegation .scratch) exactRule 2048 = 1 ∧
    ptpPeakQubits (policy.withNegation .scratch) exactRule 2048 = 3 * 2048 + 950 + 1 ∧ ptpPeakQubits (policy.withNegation .scratch) exactRule 2048 = 7095 := by
  decide +kernel

/-- `scratch`, the scan rule: workspace 6206, clean scratch 1, peak `3 * 2048 + 6206 + 1 = 12351`. -/
theorem scratch_scan :
    ptpWsTD (policy.withNegation .scratch) ptpScanWidth 2048 = 6206 ∧ ptpCleanAncD (policy.withNegation .scratch) ptpScanWidth 2048 = 1 ∧
    ptpPeakQubits (policy.withNegation .scratch) ptpScanWidth 2048 = 3 * 2048 + 6206 + 1 ∧ ptpPeakQubits (policy.withNegation .scratch) ptpScanWidth 2048 = 12351 := by
  decide +kernel

/-- The `ptpQubits` formula (scan widths), `scratch`: 14786. -/
theorem scratch_ptpQubits : ptpQubits (policy.withNegation .scratch) 2048 = 14786 := by decide +kernel

/-- The two methods agree on this policy, at both width rules (as `no_negate` predicts). -/
theorem methods_agree :
    ptpPeakQubits (policy.withNegation .scratch) exactRule 2048 = ptpPeakQubits policy exactRule 2048 ∧
    ptpPeakQubits (policy.withNegation .scratch) ptpScanWidth 2048 = ptpPeakQubits policy ptpScanWidth 2048 := by
  rw [scratch_exact.2.2.2, oneQubit_exact.2.2.2, scratch_scan.2.2.2, oneQubit_scan.2.2.2]; exact ⟨rfl, rfl⟩

/-- **Headline, `oneQubit`, exact widths.** Some circuit following board row `6f7d25984ff8`'s policy (a `PolicyImplX`) has framework qubit count at most 7095 at `n = 2048`. An upper bound on an
existential circuit (`ptp_peak_qubits_exact`), not an equality. -/
theorem peak_oneQubit_exact (X : Fin 3 → ExtReg) (base : ℕ) (hG : Good X 2048 base) :
    ∃ (W : List ℕ) (G : Angle → LowGate), PolicyImplX policy X 2048 W G ∧
      ∀ φ, LowGate.qubitCount (policy).resourceModel (G φ) ≤ 7095 := by
  obtain ⟨W, G, hI, h⟩ := ptp_peak_qubits_exact policy 2048 X base check hG
  refine ⟨W, G, hI, fun φ => ?_⟩
  have h3 := (h φ).2.2
  rw [oneQubit_exact.2.2.2] at h3
  exact h3

