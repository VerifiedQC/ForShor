namespace Shor.PTP.Peak.Board.Row265a0f53acbc

open Shor PolicySubmission.Policies.Board.Row265a0f53acbc

/-- No table of this policy contains a `negate`, so the negation method cannot enter its census. -/
theorem no_negate : policy.bands.map (fun b => negCount b.table.ops) = [0] := by decide +kernel

/-- The Lean policy is board row `265a0f53acbc`: its exact-width ladder from 2048 is the ladder printed on the row,
`2048:4 -> 519:4 -> 139:leaf` (re-exported from `PolicySubmission.Policies.Board.Row265a0f53acbc.ladder_exact`). -/
theorem board_ladder : policy.ladderX 2048 = [(2048, some 4), (519, some 4), (139, none)] :=
  ladder_exact

/-- `oneQubit`, the exact rule (the board's): workspace 197, clean scratch 1, peak `3 * 2048 + 197 + 1 = 6342`. -/
theorem oneQubit_exact :
    ptpWsTD policy exactRule 2048 = 197 ∧ ptpCleanAncD policy exactRule 2048 = 1 ∧
    ptpPeakQubits policy exactRule 2048 = 3 * 2048 + 197 + 1 ∧ ptpPeakQubits policy exactRule 2048 = 6342 := by
  decide +kernel

/-- `oneQubit`, the scan rule: workspace 707, clean scratch 1, peak `3 * 2048 + 707 + 1 = 6852`. -/
theorem oneQubit_scan :
    ptpWsTD policy ptpScanWidth 2048 = 707 ∧ ptpCleanAncD policy ptpScanWidth 2048 = 1 ∧
    ptpPeakQubits policy ptpScanWidth 2048 = 3 * 2048 + 707 + 1 ∧ ptpPeakQubits policy ptpScanWidth 2048 = 6852 := by
  decide +kernel

/-- The `ptpQubits` formula (scan widths), `oneQubit`: 7922. -/
theorem oneQubit_ptpQubits : ptpQubits policy 2048 = 7922 := by decide +kernel

/-- `scratch`, the exact rule (the board's): workspace 197, clean scratch 1, peak `3 * 2048 + 197 + 1 = 6342`. -/
theorem scratch_exact :
    ptpWsTD (policy.withNegation .scratch) exactRule 2048 = 197 ∧ ptpCleanAncD (policy.withNegation .scratch) exactRule 2048 = 1 ∧
    ptpPeakQubits (policy.withNegation .scratch) exactRule 2048 = 3 * 2048 + 197 + 1 ∧ ptpPeakQubits (policy.withNegation .scratch) exactRule 2048 = 6342 := by
  decide +kernel

/-- `scratch`, the scan rule: workspace 707, clean scratch 1, peak `3 * 2048 + 707 + 1 = 6852`. -/
theorem scratch_scan :
    ptpWsTD (policy.withNegation .scratch) ptpScanWidth 2048 = 707 ∧ ptpCleanAncD (policy.withNegation .scratch) ptpScanWidth 2048 = 1 ∧
    ptpPeakQubits (policy.withNegation .scratch) ptpScanWidth 2048 = 3 * 2048 + 707 + 1 ∧ ptpPeakQubits (policy.withNegation .scratch) ptpScanWidth 2048 = 6852 := by
  decide +kernel

/-- The `ptpQubits` formula (scan widths), `scratch`: 7922. -/
theorem scratch_ptpQubits : ptpQubits (policy.withNegation .scratch) 2048 = 7922 := by decide +kernel

/-- The two methods agree on this policy, at both width rules (as `no_negate` predicts). -/
theorem methods_agree :
    ptpPeakQubits (policy.withNegation .scratch) exactRule 2048 = ptpPeakQubits policy exactRule 2048 ∧
    ptpPeakQubits (policy.withNegation .scratch) ptpScanWidth 2048 = ptpPeakQubits policy ptpScanWidth 2048 := by
  rw [scratch_exact.2.2.2, oneQubit_exact.2.2.2, scratch_scan.2.2.2, oneQubit_scan.2.2.2]; exact ⟨rfl, rfl⟩

/-- **Headline, `oneQubit`, exact widths.** Some circuit following board row `265a0f53acbc`'s policy (a `PolicyImplX`) has framework qubit count at most 6342 at `n = 2048`. An upper bound on an
existential circuit (`ptp_peak_qubits_exact`), not an equality. -/
theorem peak_oneQubit_exact (X : Fin 3 → ExtReg) (base : ℕ) (hG : Good X 2048 base) :
    ∃ (W : List ℕ) (G : Angle → LowGate), PolicyImplX policy X 2048 W G ∧
      ∀ φ, LowGate.qubitCount (policy).resourceModel (G φ) ≤ 6342 := by
  obtain ⟨W, G, hI, h⟩ := ptp_peak_qubits_exact policy 2048 X base check hG
  refine ⟨W, G, hI, fun φ => ?_⟩
  have h3 := (h φ).2.2
  rw [oneQubit_exact.2.2.2] at h3
  exact h3

