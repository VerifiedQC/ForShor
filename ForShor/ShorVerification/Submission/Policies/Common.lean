import ForShor.ShorVerification.Framework.ToomCookTable
import ForShor.ShorVerification.Framework.Policy
import ForShor.ShorVerification.Submission.Decide
import ForShor.ShorVerification.Submission.PolicyDecide
import ForShor.ShorVerification.Submission.Audit
import ForShor.ShorVerification.Implementation.PhaseTripleProduct.Statement

/-!
# Threshold and declared-width acceptance for banded policies (shared by `Policies/*.lean`)

The twelve policies under `Submission/Policies/` come from the sister repositories' `policies/*.json`
(generated by `scripts/policy_json_to_lean.py`-style tooling, see the generator in the swap-002 spike
directory). Two of the checks those repositories apply to a policy are not part of
`ShorPolicySubmission` itself:

* the **threshold rule**: on the recursion actually taken from a target width `n`, every band that is
  chosen applies at a width `≥ k` and strictly shrinks the width (a band that does not shrink would
  silently fall through to the schoolbook leaf, and a band applied below its `k` has degenerate limbs);
* a **declared ladder** of working widths: a cost model's claimed recursion must never declare a
  width below the width the compiler needs, and must itself obey the threshold rule.

`PTPPolicy.chainContractsTight` is the PTP form of the first rule (`PhaseTripleProduct/Statement.lean`).
This file states the same rule for the phase product (PP), over `ShorLoweringPolicy` and the
compiler's width rule (`Shor.RecursivePhaseWorkspace.nextWidthBy`), so a PP policy and a PTP policy
are judged by the same rule. Nothing here is an admissibility condition of `ShorPolicySubmission`:
the library's correctness theorem is generic in the policy. These are decidable `Bool`s, to be closed
by `decide +kernel`, whose `false` is the rejection of a negative control.
-/

namespace PolicySubmission.Policies

open Shor Operations

/-- The child width of table `T` at operand width `n` under width rule `R`
(`nextWidthBy R T.ops n n`, what the recursion allocates for the next level). -/
def childWidth (R : WidthRule) (T : ToomCookTable) (n : ℕ) : ℕ :=
  RecursivePhaseWorkspace.nextWidthBy R T.ops n n

/-- Fuelled walk down the recursion of `P`, recording each width and the arity chosen there
(`none` at a leaf, including a width where the chosen table does not shrink). -/
def ladderFuel (R : WidthRule) (P : ShorLoweringPolicy) : ℕ → ℕ → List (ℕ × Option ℕ)
  | 0, n => [(n, none)]
  | f + 1, n =>
      match P.choose n with
      | none => [(n, none)]
      | some T =>
          if childWidth R T n < n then (n, some T.k) :: ladderFuel R P f (childWidth R T n)
          else [(n, none)]

/-- The recursion ladder of `P` from width `n` under width rule `R`. -/
def ladder (R : WidthRule) (P : ShorLoweringPolicy) (n : ℕ) : List (ℕ × Option ℕ) :=
  ladderFuel R P (n + 1) n

/-- One rung is admissible: a `none` rung is a genuine leaf (no band is chosen there, rather than a
chosen band failing to shrink), and a `some k` rung has `k ≤ w`. -/
def rungOK (P : ShorLoweringPolicy) : ℕ × Option ℕ → Bool
  | (w, none) => (P.choose w).isNone
  | (w, some k) => decide (k ≤ w)

/-- **The threshold rule for PP policies.** Every band chosen on the recursion from `n` under width
rule `R` strictly shrinks the width and is applied at a width `≥ k`. -/
def chainContracts (R : WidthRule) (P : ShorLoweringPolicy) (n : ℕ) : Bool :=
  (ladder R P n).all (rungOK P)

/-- What the recursion does at width `w`: `some k` when the chosen table recurses there, `none` at a
leaf width. -/
def levelK (R : WidthRule) (P : ShorLoweringPolicy) (w : ℕ) : Option ℕ :=
  match P.choose w with
  | none => none
  | some T => if childWidth R T w < w then some T.k else none

/-- **A declared ladder never under-declares the working width.** Every `k` tag is what the recursion
does at that width, and every declared step from a width where a table is chosen goes to a smaller
width that is at least the width rule's child width. -/
def declOK (R : WidthRule) (P : ShorLoweringPolicy) : List (ℕ × Option ℕ) → Bool
  | (w, kd) :: (w', k') :: rest =>
      decide (kd = levelK R P w) &&
      (match P.choose w with
        | none => true
        | some T => decide (childWidth R T w ≤ w') && decide (w' < w)) &&
      declOK R P ((w', k') :: rest)
  | [(w, kd)] => decide (kd = levelK R P w)
  | [] => true

/-- **The threshold rule on a declared ladder.** Every rung passes `rungOK`, and only the last rung may
be `none` (nothing is declared after the leaf). -/
def declThresholdOK (P : ShorLoweringPolicy) (decl : List (ℕ × Option ℕ)) : Bool :=
  decl.all (rungOK P) && decl.dropLast.all (fun r => r.2.isSome)

/-- Everything a PP policy has to satisfy at target width `n` under rule `R`: the threshold rule, and
the declared ladder (if any) on both counts. -/
def accepts (R : WidthRule) (P : ShorLoweringPolicy) (n : ℕ) (decl : Option (List (ℕ × Option ℕ))) :
    Bool :=
  chainContracts R P n &&
    (match decl with
      | none => true
      | some d => declOK R P d && declThresholdOK P d)

/-- Is a PTP policy's whole acceptance claim true at target width `n`: the contract on every band and
the thresholds' strict decrease (`PTPPolicy.check`), and the exact-width threshold rule
(`PTPPolicy.chainContractsTight`). -/
def ptpAccepts (P : PTP.PTPPolicy) (n : ℕ) : Bool :=
  P.check && P.chainContractsTight n

end PolicySubmission.Policies
