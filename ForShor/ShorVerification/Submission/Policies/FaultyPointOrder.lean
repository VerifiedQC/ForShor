import ForShor.ShorVerification.Submission.Policies.Common

/-!
# `policies/faulty_point_order.json` as a negative control (rejected: C3)

Generated by `gen_policies.py` (swap-002 shard S5a) from: "fault challenge: k=2 table, declared point order 0,inf,1 but consumed 0,1,inf"

The negation method is the default (`.oneQubit`); the policy states no override.
-/

namespace PolicySubmission.Policies.FaultyPointOrder

open Shor Operations

/-- Table 0: k = 2, 3 points, 5 operations. -/
abbrev t0K : ℕ := 2

def t0Pts : List Point :=
  [Point.int 0, Point.frac 0, Point.int 1]

def t0Ops : Prog t0K :=
  [ valid_ops.phaseProduct 0
  , valid_ops.addScaled 0 1 false 0
  , valid_ops.phaseProduct 0
  , valid_ops.addScaled 0 1 true 0
  , valid_ops.phaseProduct 1 ]

theorem t0Hpts : t0Pts.length = q t0K := rfl

/-- The faulty table as plain data (`ToomCookTable` carries no side conditions). -/
def faultyTable : ToomCookTable where
  k := t0K
  hk := by decide
  pts := t0Pts
  hpts := t0Hpts
  ops := t0Ops

/-- C1 and C2 are fine: the points are distinct and there are `2k - 1` of them. -/
theorem faulty_good : GoodToomCookPoints t0K t0Pts t0Hpts :=
  goodToomCookPoints_of_distinct t0Hpts (by decide +kernel)

/-- C4 is fine: the program returns the start state. -/
theorem faulty_returns : run? t0Ops State.start_state = some State.start_state := by decide +kernel

/-- **Rejected (C3).** The program consumes `0, 1, ∞`, not the declared `0, ∞, 1`. -/
theorem faulty_not_consumes :
    ¬ ProgConsumesPtsSafe (k := t0K) (by decide) State.start_state t0Ops t0Pts := by decide +kernel

/-- So the table is not admissible, and no `ShorLoweringSetup` / `ShorPolicySubmission` can carry it. -/
theorem faulty_not_admissible : ¬ faultyTable.Admissible :=
  fun h => faulty_not_consumes h.2.1

/-- The one-band policy over it is not admissible either. -/
def faultyPolicy : ShorLoweringPolicy where
  bands := [⟨20, faultyTable⟩]
  sorted := by decide

theorem faultyPolicy_not_admissible : ¬ faultyPolicy.Admissible :=
  fun h => faulty_not_admissible (h ⟨20, faultyTable⟩ (List.mem_singleton_self _))

/-- Positive control: the same program with the order it actually consumes is a valid table. -/
def fixedPts : List Point := [Point.int 0, Point.int 1, Point.frac 0]

theorem fixedHpts : fixedPts.length = q t0K := rfl

theorem fixed_consumes :
    ProgConsumesPtsSafe (k := t0K) (by decide) State.start_state t0Ops fixedPts := by decide +kernel

theorem fixed_good : GoodToomCookPoints t0K fixedPts fixedHpts :=
  goodToomCookPoints_of_distinct fixedHpts (by decide +kernel)

/-- The corrected table, as a submission record. -/
def fixed : ShorLoweringSetup where
  k := t0K
  hk := by decide
  pts := fixedPts
  hpts := fixedHpts
  good := fixed_good
  ops := t0Ops
  consumes := fixed_consumes
  returns := faulty_returns

end PolicySubmission.Policies.FaultyPointOrder

open Shor.Audit

